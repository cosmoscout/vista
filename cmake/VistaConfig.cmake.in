@PACKAGE_INIT@
include ("${CMAKE_CURRENT_LIST_DIR}/VistaTargets.cmake")

set(VISTA_BUILD_KERNEL @VISTA_BUILD_KERNEL@)
set(VISTA_CORELIBS_USE_SDL2_WINDOWIMP @VISTA_CORELIBS_USE_SDL2_WINDOWIMP@)
set(VISTA_CORELIBS_USE_GLUT_WINDOWIMP @VISTA_CORELIBS_USE_GLUT_WINDOWIMP@)
set(VISTA_CORELIBS_USE_OPENVR @VISTA_CORELIBS_USE_OPENVR@)
set(VISTA_CORELIBS_USE_OCULUSSDK @VISTA_CORELIBS_USE_OCULUSSDK@)
set(VISTA_CORELIBS_USE_ZEROMQ @VISTACORELIBS_USE_ZEROMQ@)

if (VISTA_BUILD_KERNEL)
    include(CMakeFindDependencyMacro)
    find_dependency(GLEW)
    find_dependency(OpenSG)

    if (VISTA_CORELIBS_USE_SDL2_WINDOWIMP)
        find_dependency(SDL2)
        find_dependency(SDL2_ttf)
    endif ()

    if (VISTA_CORELIBS_USE_GLUT_WINDOWIMP)
        find_dependency(GLUT)
    endif ()

    if (VISTA_CORELIBS_USE_OPENVR)
        find_dependency(OpenVR)
    endif ()

    if (VISTA_CORELIBS_USE_OCULUSSDK)
        find_dependency(OVR REQUIRED)
    endif ()

    if (VISTA_CORELIBS_USE_ZEROMQ)
        find_dependency(cppzmq)
    endif ()
endif()
