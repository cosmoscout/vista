@PACKAGE_INIT@
include ("${CMAKE_CURRENT_LIST_DIR}/VistaTargets.cmake")

set(VISTA_BUILD_KERNEL @VISTA_BUILD_KERNEL@)
set(VISTACORELIBS_USE_SDL2_WINDOWIMP @VISTACORELIBS_USE_SDL2_WINDOWIMP@)
set(VISTACORELIBS_USE_GLUT_WINDOWIMP @VISTACORELIBS_USE_GLUT_WINDOWIMP@)
set(VISTACORELIBS_USE_ZEROMQ @VISTACORELIBS_USE_ZEROMQ@)

if (VISTA_BUILD_KERNEL)
    include(CMakeFindDependencyMacro)
    find_dependency(GLEW)
    find_dependency(OpenSG)

    if (VISTACORELIBS_USE_SDL2_WINDOWIMP)
        find_dependency(SDL2)
        find_dependency(SDL2_ttf)
    endif ()

    if (VISTACORELIBS_USE_GLUT_WINDOWIMP)
        find_dependency(GLUT)
    endif ()

    if (VISTACORELIBS_USE_ZEROMQ)
        find_dependency(ZMQ)
    endif ()
endif()